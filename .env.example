# Copy this file to .env and fill in real values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# Optional PostgreSQL URL, e.g. postgres://user:password@localhost:5432/averixa_shop
DATABASE_URL=
# Stripe is disabled until real test/live keys are provided.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Email: if blank, Django console email backend is used in DEBUG.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=shop@example.com
